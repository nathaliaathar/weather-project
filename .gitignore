# ============================================================
# WHAT THIS FILE DOES
# ============================================================
# Tells Git which files must NEVER be uploaded to GitHub.
# Especially: your real API key.
# ============================================================

# Virtual env (installed packages — do not commit these folders)
.venv/
venv/
env/

# Secrets — never commit real keys
.env
.streamlit/secrets.toml

# Python leftovers
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Jupyter leftovers
.ipynb_checkpoints/

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local experiments
*.log
data/cache/
