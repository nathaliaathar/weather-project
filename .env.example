# ============================================================
# WHAT THIS FILE DOES
# ============================================================
# Example of a .env file. A .env file stores secret values on
# your computer (here: the OpenWeatherMap API key used for the
# 5-day / 3-hour forecast).
#
# An environment variable is a name=value pair your program can
# read without putting the secret inside the Python code.
#
# STEPS:
#   1. Copy this file and rename the copy to .env
#   2. Get a free key: https://home.openweathermap.org/api_keys
#   3. Replace your_key_here with the real key
#   4. Never commit the real .env file (see .gitignore)
# ============================================================

OPENWEATHER_API_KEY=your_key_here
